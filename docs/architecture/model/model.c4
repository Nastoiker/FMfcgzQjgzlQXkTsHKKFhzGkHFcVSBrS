specification {
  color audience #645570
  color cabinetviolet #625AC4
  color outside #685D70
  color runtimecolor #5E59C4
  color datacolor #26766D
  color modulecolor #466B9E
  color symbolcolor #47688D
  color tablecolor #367565

  element actor {
    notation 'Человек'
    style {
      shape person
      color audience
    }
  }

  element system {
    notation 'Программная система'
    style {
      shape rectangle
      color cabinetviolet
    }
  }

  element external {
    notation 'Внешняя система'
    style {
      shape rectangle
      color outside
    }
  }

  element container {
    notation 'Приложение или веб-сервер'
    style {
      shape rectangle
      color runtimecolor
    }
  }

  element database {
    notation 'База данных'
    style {
      shape storage
      color datacolor
    }
  }

  element component {
    notation 'Компонент'
    style {
      shape rectangle
      color modulecolor
    }
  }

  element code {
    notation 'Класс, функция или объект'
    style {
      shape rectangle
      color symbolcolor
    }
  }

  element table {
    notation 'Таблица'
    style {
      shape storage
      color tablecolor
    }
  }
}

model {
  actor client 'Клиент' {
    description 'Менеджер одной компании. Смотрит показатели и обрабатывает отзывы своих филиалов.'
  }

  actor admin 'Администратор' {
    description 'Выбирает компанию, просматривает её филиалы и запускает импорт.'
  }


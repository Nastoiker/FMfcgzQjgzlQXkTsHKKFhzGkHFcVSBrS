generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id       Int      @id
  name     String
  branches Branch[]
  users    User[]

  @@map("companies")
}

model User {
  id         Int      @id @default(autoincrement())
  login      String   @unique
  role       String
  password   String
  company_id Int?
  company    Company? @relation(fields: [company_id], references: [id])

  @@map("users")
}

model Branch {
  id         Int           @id
  company_id Int
  name       String
  company    Company       @relation(fields: [company_id], references: [id])
  metrics    DailyMetric[]
  reviews    Review[]
  imports    ImportRun[]

  @@index([company_id])
  @@map("branches")
}

model DailyMetric {
  branch_id Int
  date      DateTime @db.Date
  views     Int
  site      Int
  calls     Int
  routes    Int
  branch    Branch   @relation(fields: [branch_id], references: [id])

  @@id([branch_id, date])
  @@map("daily_metrics")
}

model Review {
  id         Int      @id @default(autoincrement())
  branch_id  Int
  created_at DateTime @db.Timestamptz
  rating     Int
  status     String
  text       String
  author     String
  branch     Branch   @relation(fields: [branch_id], references: [id])

  @@index([branch_id, rating, status])
  @@index([branch_id, created_at(sort: Desc), id], map: "reviews_branch_date_id_idx")
  @@map("reviews")
}

model ImportRun {
  id         Int      @id @default(autoincrement())
  branch_id  Int
  started_at DateTime @default(now()) @db.Timestamptz
  date_from  DateTime @db.Date
  date_to    DateTime @db.Date
  rows       Int      @default(0)
  attempts   Int      @default(0)
  status     String
  error      String?
  branch     Branch   @relation(fields: [branch_id], references: [id])

  @@map("import_runs")
}

model LoginWindow {
  key        String   @id
  attempts   Int
  expires_at DateTime @db.Timestamptz(3)

  @@index([expires_at])
  @@map("login_windows")
}
